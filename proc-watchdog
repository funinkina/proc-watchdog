#!/bin/bash
# proc-watchdog: macOS notifications for long-running CPU hogs and memory hogs, plus cleanup of orphaned workers.
set -u

VERSION=0.1.0
LABEL=local.proc-watchdog
CONFIG_DIR=${PROC_WATCHDOG_CONFIG_DIR:-$HOME/.config/proc-watchdog}
STATE_DIR=${PROC_WATCHDOG_STATE_DIR:-$HOME/Library/Caches/proc-watchdog}
BIN=$HOME/.local/bin/proc-watchdog
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist

# shellcheck disable=SC2016
DEFAULT_CONFIG='# proc-watchdog config (shell syntax).
# Run `proc-watchdog install` again after changing INTERVAL_SECONDS.

# How often to check, in seconds.
INTERVAL_SECONDS=300

# Alert when a process stays at or above CPU_PERCENT (100 = one full core) for CPU_MINUTES.
CPU_PERCENT=80
CPU_MINUTES=20

# Alert when a process uses at least MEM_GB of resident memory.
MEM_GB=3

# Extended regex matched against the full command line. Matching processes never alert. Empty = none.
IGNORE=""

# Extended regex. A matching process whose parent has exited (PPID 1) is an orphan.
ORPHAN_PATTERN="vitest/dist/workers/|jest-worker/build/workers/"

# What to do with orphans: kill | notify | off
ORPHAN_ACTION=kill

# false = only write to the log, no macOS notifications.
NOTIFY=true
'

die() { echo "proc-watchdog: $*" >&2; exit 1; }

load_config() {
  eval "$DEFAULT_CONFIG"
  # shellcheck source=/dev/null
  if [ -f "$CONFIG_DIR/config" ]; then . "$CONFIG_DIR/config"; fi
  for k in INTERVAL_SECONDS CPU_PERCENT CPU_MINUTES; do
    [[ ${!k} =~ ^[0-9]+$ ]] || die "$k must be a whole number, got '${!k}'"
  done
  [[ $MEM_GB =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "MEM_GB must be a number, got '$MEM_GB'"
  [[ $ORPHAN_ACTION =~ ^(kill|notify|off)$ ]] || die "ORPHAN_ACTION must be kill, notify or off"
  [[ $NOTIFY =~ ^(true|false)$ ]] || die "NOTIFY must be true or false"
}

alert() {
  echo "$(date '+%F %T')  $1 | $2" >> "$STATE_DIR/log"
  [ "$NOTIFY" = true ] || return 0
  osascript -e 'on run a' -e 'display notification (item 2 of a) with title (item 1 of a)' -e 'end run' "$1" "$2" >/dev/null
}

name_of() { local n=${1%% -*}; echo "${n##*/}"; }

run() {
  mkdir -p "$STATE_DIR"
  cd "$STATE_DIR" || die "cannot use $STATE_DIR"
  touch hot.tsv notified.tsv
  local now last
  now=$(date +%s)
  last=$(cat last_run 2>/dev/null || echo 0)
  # A gap means sleep or missed runs, so CPU streaks can't be trusted.
  if (( now - last > 2 * INTERVAL_SECONDS )); then : > hot.tsv; fi
  echo "$now" > last_run

  # pid ppid %cpu rss(KB) command, tab-separated
  ps -Ao pid=,ppid=,pcpu=,rss=,command= |
    awk '{c=$0; sub(/^ *[0-9]+ +[0-9]+ +[0-9.]+ +[0-9]+ /, "", c); print $1 "\t" $2 "\t" $3 "\t" $4 "\t" c}' > procs.tsv

  if [ "$ORPHAN_ACTION" != off ] && [ -n "$ORPHAN_PATTERN" ]; then
    awk -F'\t' -v re="$ORPHAN_PATTERN" -v me=$$ '$2 == 1 && $1 != me && $5 ~ re {print $1 "\t" $5}' procs.tsv |
      while IFS=$'\t' read -r pid cmd; do
        if [ "$ORPHAN_ACTION" = kill ]; then
          kill "$pid" 2>/dev/null || continue
          sleep 2
          if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; fi
          alert "Killed orphaned $(name_of "$cmd") (PID $pid)" "$cmd"
        elif ! grep -qxF "$pid"$'\t'orphan$'\t'"$cmd" notified.tsv; then
          alert "Orphaned $(name_of "$cmd") (PID $pid)" "kill $pid · $cmd"
          printf '%s\torphan\t%s\n' "$pid" "$cmd" >> notified.tsv
        fi
      done
  fi

  # hot: pid, first time seen at/above CPU_PERCENT, command
  awk -F'\t' -v cpu="$CPU_PERCENT" -v now="$now" -v ign="$IGNORE" '
    FILENAME == ARGV[1] { since[$1 FS $3] = $2; next }
    $3 >= cpu && !(ign != "" && $5 ~ ign) { k = $1 FS $5; print $1 "\t" (k in since ? since[k] : now) "\t" $5 }
  ' hot.tsv procs.tsv > hot.new && mv hot.new hot.tsv

  awk -F'\t' -v mins="$CPU_MINUTES" -v now="$now" -v gb="$MEM_GB" -v ign="$IGNORE" '
    FILENAME == ARGV[1] { seen[$1 FS $2 FS $3] = 1; next }
    FILENAME == ARGV[2] { since[$1 FS $3] = $2; next }
    ign != "" && $5 ~ ign { next }
    {
      k = $1 FS $5
      if (k in since) {
        m = int((now - since[k]) / 60)
        if (m >= mins && !seen[$1 FS "cpu" FS $5]) printf "%s\tcpu\t%s%% CPU for %d+ min\t%s\n", $1, $3, m, $5
      }
      if ($4 >= gb * 1048576 && !seen[$1 FS "mem" FS $5]) printf "%s\tmem\t%.1f GB memory\t%s\n", $1, $4 / 1048576, $5
    }
  ' notified.tsv hot.tsv procs.tsv > alerts.tsv
  while IFS=$'\t' read -r pid kind what cmd; do
    alert "$(name_of "$cmd") (PID $pid)" "$what · kill $pid"
    printf '%s\t%s\t%s\n' "$pid" "$kind" "$cmd" >> notified.tsv
  done < alerts.tsv

  # Forget alerts for processes that are gone, so a new process reusing the PID can alert.
  awk -F'\t' 'FILENAME == ARGV[1] { alive[$1 FS $5] = 1; next } alive[$1 FS $3]' procs.tsv notified.tsv > notified.new && mv notified.new notified.tsv
}

install() {
  mkdir -p "${BIN%/*}" "$CONFIG_DIR" "$STATE_DIR" "${PLIST%/*}"
  if ! [ "$0" -ef "$BIN" ]; then cp "$0" "$BIN"; fi
  chmod +x "$BIN"
  if [ -f "$CONFIG_DIR/config" ]; then
    echo "Keeping existing config: $CONFIG_DIR/config"
  else
    printf '%s' "$DEFAULT_CONFIG" > "$CONFIG_DIR/config"
    echo "Wrote config: $CONFIG_DIR/config"
  fi
  load_config
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>run</string></array>
  <key>StartInterval</key><integer>$INTERVAL_SECONDS</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$STATE_DIR/stdout.log</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/stderr.log</string>
</dict>
</plist>
EOF
  if launchctl bootout "gui/$UID/$LABEL" 2>/dev/null; then sleep 1; fi
  launchctl bootstrap "gui/$UID" "$PLIST" || die "launchctl bootstrap failed"
  echo "Installed $BIN, checking every ${INTERVAL_SECONDS}s."
}

uninstall() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  rm -f "$PLIST" "$BIN"
  rm -rf "$STATE_DIR"
  echo "Uninstalled. Config left at $CONFIG_DIR."
}

status() {
  if launchctl print "gui/$UID/$LABEL" > "$STATE_DIR/.status" 2>/dev/null; then
    grep -E $'^\t(state|last exit code|run interval) =' "$STATE_DIR/.status"
  else
    echo "not installed"
  fi
  rm -f "$STATE_DIR/.status"
  echo "config: $CONFIG_DIR/config"
  echo "log:    $STATE_DIR/log"
  if [ -s "$STATE_DIR/log" ]; then echo; tail -n 10 "$STATE_DIR/log"; fi
}

usage() {
  cat <<EOF
proc-watchdog $VERSION

Usage: proc-watchdog <command>

  install     Install to $BIN and start checking in the background (re-run after editing INTERVAL_SECONDS)
  uninstall   Stop and remove; keeps your config
  run         Run one check now
  status      Show whether it's running and the last alerts
  config      Print the config file path
EOF
}

case ${1:-} in
  run) load_config; run ;;
  install) install ;;
  uninstall) uninstall ;;
  status) mkdir -p "$STATE_DIR"; status ;;
  config) echo "$CONFIG_DIR/config" ;;
  -v|--version) echo "$VERSION" ;;
  *) usage ;;
esac
